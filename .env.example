# One Vercel AI Gateway key authenticates Jev and optional vision.
# Copy this file to .env and replace the placeholder. Never commit .env.
AI_GATEWAY_API_KEY=replace-with-your-vercel-ai-gateway-key

# Optional: defaults are used when these variables are absent.
# VISION_MODEL is only used with --observation vision.
JEV_MODEL=typesafe-ai/jev
VISION_MODEL=google/gemini-2.5-flash
