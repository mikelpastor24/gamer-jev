# Copy this file to .env. Set only credentials for selected providers; never commit .env.
# Direct Jev: --agent typesafe. Not needed for Gateway or mock decisions.
TYPESAFE_API_KEY=replace-with-your-typesafe-api-key

# Vercel Jev: --agent gateway. Vercel vision: --vision gateway.
# If both use Gateway, this one key authenticates both.
AI_GATEWAY_API_KEY=replace-with-your-vercel-ai-gateway-key

# Optional defaults. Only settings for selected providers are read and validated.
TYPESAFE_MODEL=jev-latest
# JEV_MODEL applies only to --agent gateway, not direct TypeSafe.
JEV_MODEL=typesafe-ai/jev
# VISION_MODEL applies only to --vision gateway.
VISION_MODEL=google/gemini-2.5-flash
