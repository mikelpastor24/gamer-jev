# Copy this file to .env, set your keys, then run npm start. Never commit .env.
# Settings -> Agent offers providers with configured keys. Restart after editing .env.
# Direct Jev: TypeSafe in Settings or --agent typesafe.
TYPESAFE_API_KEY=replace-with-your-typesafe-api-key

# Vercel Jev or vision: Gateway in Settings, --agent gateway, or --vision gateway.
# If both use Gateway, this one key authenticates both.
AI_GATEWAY_API_KEY=replace-with-your-vercel-ai-gateway-key

# Optional model defaults, editable in Settings -> Agent -> Mode & models.
# Only selected providers validate their model and credentials.
TYPESAFE_MODEL=jev-latest
# JEV_MODEL applies only to --agent gateway, not direct TypeSafe.
JEV_MODEL=typesafe-ai/jev
# VISION_MODEL applies only to --vision gateway.
VISION_MODEL=google/gemini-2.5-flash
