{
  "name": "gamer-jev",
  "version": "0.1.0",
  "private": true,
  "description": "Game-agnostic emulated gameplay with TypeSafe AI's Jev, game-reader strategies, and optional vision.",
  "type": "module",
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts --demo",
    "agent:demo": "tsx src/cli.ts --demo --agent mock --observation state --goal \"Exercise the controller and inspect the game state\"",
    "headless": "tsx src/cli.ts --headless",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci"
  },
  "dependencies": {
    "pngjs": "7.0.0",
    "serverboy": "0.0.7"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "^22.18.0",
    "@types/pngjs": "6.0.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
